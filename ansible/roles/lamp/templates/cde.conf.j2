# Gere par Ansible (role lamp) - ne pas modifier a la main
<VirtualHost *:80>
    ServerName {{ lamp_url | urlsplit('hostname') }}
    DocumentRoot {{ lamp_racine }}/public

    <Directory {{ lamp_racine }}/public>
        AllowOverride All
        Require all granted
    </Directory>

    # Configuration du site, lue par getenv() comme dans le conteneur.
    SetEnv DB_HOST localhost
    SetEnv DB_NAME {{ lamp_base }}
    SetEnv DB_USER {{ lamp_utilisateur_base }}
    SetEnv DB_PASSWORD {{ lamp_mdp_base }}
    SetEnv SITE_URL {{ lamp_url }}

    # proxy01 transmet l'adresse du visiteur et le HTTPS.
    RemoteIPHeader X-Forwarded-For
    RemoteIPInternalProxy {{ lamp_proxy }}
    SetEnvIf X-Forwarded-Proto https HTTPS=on

    ErrorLog ${APACHE_LOG_DIR}/cde-error.log
    CustomLog ${APACHE_LOG_DIR}/cde-access.log combined
</VirtualHost>
