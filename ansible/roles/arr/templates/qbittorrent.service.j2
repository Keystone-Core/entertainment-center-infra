# {{ ansible_managed }}
[Unit]
Description=qBittorrent (interface web)
After=network-online.target
Wants=network-online.target

[Service]
User=qbittorrent
Group={{ arr_groupe_media }}
# Fichiers lisibles et modifiables par le groupe media (Sonarr, Radarr, Jellyfin).
UMask=0002
Type=simple
ExecStart=/usr/bin/qbittorrent-nox --profile={{ arr_qbittorrent_profil }}
# qBittorrent enregistre l'etat des torrents en s'arretant.
TimeoutStopSec=60
Restart=on-failure

[Install]
WantedBy=multi-user.target
